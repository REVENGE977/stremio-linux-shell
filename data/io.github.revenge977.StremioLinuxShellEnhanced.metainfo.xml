<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.revenge977.StremioLinuxShellEnhanced</id>
    <name>Stremio Enhanced Shell</name>
    <summary>Community-enhanced native Linux desktop client based on Stremio Linux Shell</summary>
    <description>
        <p>Stremio Enhanced Shell is a community-enhanced native Linux desktop client building upon Stremio Linux Shell.</p>
        <p>Featuring native hardware-accelerated MPV playback, WebKitGTK frontend, community themes and plugins marketplace integration, Discord Rich Presence, and streaming server management.</p>
    </description>
    <developer id="io.github.revenge977">
        <name>REVENGE977</name>
    </developer>

    <branding>
        <color type="primary" scheme_preference="light">#9C97D8</color>
        <color type="primary" scheme_preference="dark">#2E286D</color>
    </branding>

